#!/usr/bin/env bash
# Complete trident environment reference — every TRI_* variable, defaults, and
# purpose. Source this (after copying) or use as docker --env-file.
# Only TRI_API_KEY (+ TRI_BACKEND/TRI_DOCKER_IMAGE when using docker) are
# strictly required; everything else has a sane default.

# ── Core ──────────────────────────────────────────────────────────────────────
export TRI_LISTEN_ADDR="0.0.0.0:8080"              # facade listen address
export TRI_API_KEY="<your-api-key>"            # front-side key Open WebUI presents (REQUIRED)
export TRI_ACTOR_API_KEY="${TRI_API_KEY}"          # keep equal: WS auth frames pass through
export TRI_BACKEND="substrate"                     # substrate | docker (dev mode)
export TRI_LOG_LEVEL="info"                        # info | debug
export TRI_STATE_DB="/var/lib/trident/sessionmap.db"  # sqlite chat→actor + egress bookkeeping
export TRI_TLS_LISTEN_ADDR=":8443"                 # egress-callback TLS listener port
export TRI_CONSOLE_TOKEN="<your-console-token>"  # human-only console token (REQUIRED, ≠ TRI_API_KEY when egress flow is on)
export TRI_CONSOLE_SHOW_DEFAULT="true"             # prefill the default console token on the pages

# ── Actor naming / substrate layout ──────────────────────────────────────────
export TRI_ATESPACE="ots-webui"                    # atespace for chat actors
export TRI_TEMPLATE_REF="ots-webui/open-terminal-v7"  # ActorTemplate "atespace/name"
export TRI_ACTOR_PREFIX="ot-"                      # actor-name prefix
export TRI_ACTOR_PORT="8000"                       # port open-terminal listens on inside the actor

# ── Lifecycle ────────────────────────────────────────────────────────────────
export TRI_IDLE_TTL="2m"                           # idle → suspend (snapshot + pod freed)
export TRI_DELETE_IDLE_TTL="48h"                   # idle → full delete (frees durable volume)
export TRI_MAX_AGE="168h"                          # hard cap from creation
export TRI_SUSPEND_DURABILITY="async"              # async | sync (snapshot durability)

# ── Substrate connection (out-of-cluster uses KUBECONFIG) ───────────────────
export TRI_API_SERVICE="api"                       # ate-api-server Service name
export TRI_API_NAMESPACE="ate-system"              # substrate system namespace
export TRI_CLIENT_SA="ate-client"                  # ServiceAccount for ateapi bearer tokens
export TRI_API_TOKEN_FILE=""                       # pre-minted token file (else SA-minted)
export TRI_ROUTE_NAMESPACE="ate-system"            # atenet-router namespace
export TRI_ROUTE_SA="atenet-client"                # ServiceAccount for router client certs
export KUBECONFIG="/home/vsupe/.kube/k3d-remote.yaml"  # kubeconfig when out-of-cluster (standard var)

# ── Egress approval flow ─────────────────────────────────────────────────────
export TRI_EGRESS_CALLBACK="ot-shim-callback.ot-workerpool.svc:8443"  # in-cluster callback Service:port
export TRI_EGRESS_HOSTS="api.anthropic.com,api.openai.com,sentry.io,pypi.org,files.pythonhosted.org,registry.npmjs.org"  # base allowlist (443)
export TRI_EGRESS_OBSERVER="true"                  # gateway-deny-log observer (name-free IP reports)
export TRI_EGRESS_OBSERVER_POD_SELECTOR="app=atenet-egress"  # gateway pod label selector

# ── Feature gates (surfaced as /api/config features to Open WebUI) ──────────
export TRI_FEATURES_JSON='{"terminal":true,"notebooks":true,"system":true,"git":true,"events":true,"agents":true,"browser":false,"desktop":false}'

# ── Docker dev backend (only when TRI_BACKEND=docker) ────────────────────────
export TRI_DOCKER_IMAGE="ot-actor:dev"             # local actor image for docker mode
export TRI_DOCKER_ENV=""                           # extra K=V,K=V for docker-mode actors

# ── Actor sizing (bootstrap only — baked into the ActorTemplate) ────────────
# 1 CPU / 2Gi covers open-terminal + one agent CLI (substrate demo-consistent).
# Workers must exceed the actor memory by the gVisor restore margin:
# 2 CPU / 4608Mi worker for a 1 CPU / 2Gi actor (manifest/ workers template).
export TRI_CPU_MILLICORES="1000"
export TRI_MEMORY_BYTES="2147483648"
