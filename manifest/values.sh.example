#!/usr/bin/env bash
# Deployment values for scripts/deploy.sh. Copy to manifest/values.sh or export
# these before running deploy. Only OCI_REPO (write access) and TRI_API_KEY are
# strictly required to be non-default.

# The registry repository for the actor image you pushed and built
# (scripts/build-actor-image.sh prints the exact digest ref it produced).
export OCI_REPO="ghcr.io/example/ot-actor"

# Actor image ref (digest-pinned). Leave empty to have deploy.sh run
# build-actor-image.sh for you.
export ACTOR_IMAGE=""

# The API key Open WebUI will present to the shim (reuse the actor key: the
# same key is injected into the actor as OPEN_TERMINAL_API_KEY so the WS auth
# frames pass through untouched).
export TRI_API_KEY="${TRI_API_KEY:-$(openssl rand -hex 24)}"

# Substrate layout (defaults match the canonical install).
export ATE_SYSTEM_NAMESPACE="ate-system"
export TRI_NAMESPACE="trident"

# Atespace for chat actors + the ActorTemplate name.
export ATESPACE="ots-webui"

# Actor sizing (see internal/backend/substrate/open-terminal-template.yaml).
export ACTOR_PORT="8000"

# Lifecycle.
export IDLE_TTL="10m"
export MAX_AGE="168h"

# v1 feature gates: terminal/files/git/agents/notebooks/events on,
# browser/desktop off (raise these later; the gVisor sandbox needs validation).
export FEATURES_JSON='{"terminal":true,"notebooks":true,"system":true,"git":true,"events":true,"agents":true,"browser":false,"desktop":false}'

# Egress allowlist (tls_passthrough rules per actor).
export EGRESS_HOSTS="api.anthropic.com,api.openai.com,sentry.io,pypi.org,files.pythonhosted.org,registry.npmjs.org"

# Agent credentials injected into the actor environment.
export ANTHROPIC_API_KEY="${ANTHROPIC_API_KEY:-}"
export OPENAI_API_KEY="${OPENAI_API_KEY:-}"

# Worker pool (one worker per actor; worker must exceed the actor's 2Gi by
# the gVisor restore margin — empirically 4608Mi; 2560Mi makes resume fail
# with "no worker has room").
export WORKERPOOL_REPLICAS="3"
export WORKERPOOL_CPU="2"
export WORKERPOOL_MEMORY="4608Mi"
