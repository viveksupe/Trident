#!/usr/bin/env bash
# Deployment values for scripts/deploy.sh. Copy to manifest/values.sh or export
# these before running deploy. Only OCI_REPO and WORKER_IMAGE are strictly
# required — deploy.sh generates any unset secret below once and persists it
# back into values.sh.

# The registry repository for the actor image you pushed and built
# (scripts/build-actor-image.sh prints the exact digest ref it produced).
export OCI_REPO="ghcr.io/example/ot-actor"

# Actor image ref (digest-pinned). Leave empty to have deploy.sh run
# build-actor-image.sh for you.
export ACTOR_IMAGE=""

# Digest-pinned ateworker image the nodes can pull (what the WorkerPool's
# workerImage renders as; empty used to silently break fresh clusters).
export WORKER_IMAGE="ghcr.io/example/ateworker@sha256:fixed"

# Three DISTINCT secrets. The API key is what Open WebUI presents. The actor
# key is baked into the ActorTemplate as OPEN_TERMINAL_API_KEY — agents hold
# the front key AND can reach the shim's callback listener, so a shared key
# would let an agent proxy to any user's actor. The console token gates the
# human approval console and must not be guessable from either key.
#
# Left empty on purpose: scripts/deploy.sh generates any that are unset ONCE
# and writes the value back into values.sh, so redeploys keep the same keys.
# (The old "$(openssl rand -hex 24)" default re-randomized on EVERY source —
# M6: Open WebUI's saved API key broke on each redeploy and the rotated actor
# key cold-booted every chat actor.) Set a value here — or in the environment
# — to choose it yourself; scripts/deploy.sh --rotate deliberately rolls all
# three (maintenance window only: saved keys break, chat actors cold-boot).
export TRI_API_KEY="${TRI_API_KEY:-}"
export TRI_ACTOR_API_KEY="${TRI_ACTOR_API_KEY:-}"
export TRI_CONSOLE_TOKEN="${TRI_CONSOLE_TOKEN:-}"

# Substrate layout (defaults match the canonical install).
export ATE_SYSTEM_NAMESPACE="ate-system"
export TRI_NAMESPACE="trident"

# Atespace for chat actors + the ActorTemplate name.
export ATESPACE="ots-webui"
export TEMPLATE_NAME="open-terminal"

# Actor sizing (see internal/backend/substrate/open-terminal-template.yaml).
export ACTOR_PORT="8000"

# Lifecycle.
export IDLE_TTL="10m"
export DELETE_IDLE_TTL="48h"
export MAX_AGE="168h"

# v1 feature gates: terminal/files/git/agents/notebooks/events on,
# browser/desktop off (raise these later; the gVisor sandbox needs validation).
export FEATURES_JSON='{"terminal":true,"notebooks":true,"system":true,"git":true,"events":true,"agents":true,"browser":false,"desktop":false}'

# Egress allowlist (tls_passthrough rules per actor). Set = the full list:
# it REPLACES the built-in defaults rather than appending.
export EGRESS_HOSTS="api.anthropic.com,api.openai.com,sentry.io,pypi.org,files.pythonhosted.org,registry.npmjs.org"

# Agent credentials injected into the actor environment.
export ANTHROPIC_API_KEY="${ANTHROPIC_API_KEY:-}"
export OPENAI_API_KEY="${OPENAI_API_KEY:-}"

# Worker pool multiplexes many chat actors per worker. Conservative pairing
# for 500m/768Mi actors: 4 CPU / 8192Mi workers hold 6-8 chats. Workers must
# still exceed one actor's restore margin, or resume fails "no worker has
# room" (seen at 2560Mi with 2Gi actors).
export WORKERPOOL_REPLICAS="3"
export WORKERPOOL_CPU="4"
export WORKERPOOL_MEMORY="8192Mi"
